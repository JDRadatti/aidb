{
	"name": "aidb",
	"version": "0.1.0",
	"private": true,
	"description": "Terminal-native debugger: pi-style TUI over GDB via DAP",
	"type": "module",
	"workspaces": [
		"debugger-core",
		"tui"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"build": "npm run build --workspace @earendil-works/pi-debugger-core",
		"test": "npm test --workspace @earendil-works/pi-debugger-core",
		"dev": "npm run dev --workspace aidb-tui",
		"start": "npm run dev"
	}
}
